<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- Main content area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="24dp">

            <!-- ═══════════════════════════════════════ -->
            <!-- Resource 1: Lecture Notes -->
            <!-- ═══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/itemLectureNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_resource_card"
                android:padding="18dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Icon -->
                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_resource_icon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lecture_notes"
                        android:contentDescription="Lecture Notes" />
                </FrameLayout>

                <!-- Label -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Lecture Notes"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textStyle="bold" />

                <!-- Arrow -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Open" />
            </LinearLayout>


            <!-- ═══════════════════════════════════════ -->
            <!-- Resource 2: Assignments -->
            <!-- ═══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/itemAssignments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_resource_card"
                android:padding="18dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Icon -->
                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_resource_icon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_assignments"
                        android:contentDescription="Assignments" />
                </FrameLayout>

                <!-- Label -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Assignments"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textStyle="bold" />

                <!-- Arrow -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Open" />
            </LinearLayout>


            <!-- ═══════════════════════════════════════ -->
            <!-- Resource 3: Practical Files (with dropdown for Bridge Course in MCA Sem 1) -->
            <!-- ═══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/itemPracticalFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_resource_card"
                android:padding="18dp"
                android:layout_marginBottom="6dp"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Icon -->
                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_resource_icon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_practical_files"
                        android:contentDescription="Practical Files" />
                </FrameLayout>

                <!-- Label -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Practical Files"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textStyle="bold" />

                <!-- Dropdown Arrow -->
                <ImageView
                    android:id="@+id/ivDropdownArrow"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Open Screen" />
            </LinearLayout>

            <!-- Practical Dropdown Sub-Items (MCA Sem 1 only — Bridge Course + Lab Records) -->
            <LinearLayout
                android:id="@+id/layoutPracticalDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <!-- Sub-Item: Bridge Course -->
                <LinearLayout
                    android:id="@+id/subItemBridgeCourse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_resource_card"
                    android:padding="12dp"
                    android:layout_marginBottom="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_primary"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Bridge Course"
                        android:textColor="@color/text_mid"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_bold" />
                </LinearLayout>

                <!-- Sub-Item: Lab Records -->
                <LinearLayout
                    android:id="@+id/subItemLabRecords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_resource_card"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/circle_primary"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Lab Records / Manuals"
                        android:textColor="@color/text_mid"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- Resource 4: PYQs Bank -->
            <!-- ═══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/itemPyqsBank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_resource_card"
                android:padding="18dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Icon -->
                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_resource_icon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_pyqs_bank"
                        android:contentDescription="PYQs Bank" />
                </FrameLayout>

                <!-- Label -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="PYQs Bank"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textStyle="bold" />

                <!-- Arrow -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Open" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- Resource 5: Sessional Test -->
            <!-- ═══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/itemSessionalTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_resource_card"
                android:padding="18dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Icon -->
                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_resource_icon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_sessional_test"
                        android:contentDescription="Sessional Test" />
                </FrameLayout>

                <!-- Label -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Sessional Test"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textStyle="bold" />

                <!-- Arrow -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Open" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════ -->
            <!-- Resource 6: Syllabus -->
            <!-- ═══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/itemSyllabus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_resource_card"
                android:padding="18dp"
                android:layout_marginBottom="12dp"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Icon -->
                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_resource_icon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_syllabus"
                        android:contentDescription="Syllabus" />
                </FrameLayout>

                <!-- Label -->
                <TextView
                    android:id="@+id/tvSyllabusLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="Syllabus"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textStyle="bold" />

                <!-- Arrow -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="Open" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>

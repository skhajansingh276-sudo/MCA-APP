<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <!-- Top Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/pdfToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1a1a2e"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_chevron_left" />

    <!-- Loading Indicator - Centered -->
    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/pdfToolbar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/pdfProgressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="#4fc3f7" />

        <TextView
            android:id="@+id/tvLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading document..."
            android:textColor="#9e9e9e"
            android:textSize="13sp"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- WebView for PDF rendering -->
    <WebView
        android:id="@+id/pdfWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#2d2d44"
        app:layout_constraintTop_toBottomOf="@id/pdfToolbar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        android:visibility="gone" />

    <!-- ImageView for images -->
    <ImageView
        android:id="@+id/pdfImageView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:background="#1a1a2e"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/pdfToolbar"
        app:layout_constraintBottom_toTopOf="@id/bottomBar" />

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#16213e"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="8dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Download Button -->
        <LinearLayout
            android:id="@+id/btnDownload"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/stat_sys_download"
                android:contentDescription="Download"
                app:tint="#4fc3f7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Download"
                android:textColor="#4fc3f7"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Share Button -->
        <LinearLayout
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_share"
                android:contentDescription="Share"
                app:tint="#81c784" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share"
                android:textColor="#81c784"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Open in Browser -->
        <LinearLayout
            android:id="@+id/btnOpenBrowser"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="Open in Browser"
                app:tint="#ffb74d" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browser"
                android:textColor="#ffb74d"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Hero Banner Carousel ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="380dp">

            <!-- Carousel ViewPager2 -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerCarousel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never" />

            <!-- Left Navigation Button -->
            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_chevron_left"
                android:contentDescription="Previous image"
                android:elevation="6dp" />

            <!-- Right Navigation Button -->
            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_circle_button"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="Next image"
                android:elevation="6dp" />

            <!-- ── Hero Info Section (Integrated into Carousel) ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ESTABLISHED 1976 -->
                <TextView
                    android:id="@+id/tvEstablished"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTABLISHED 1976"
                    android:textColor="@color/accent_gold"
                    android:textSize="9sp"
                    android:letterSpacing="0.2"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginBottom="4dp" />

                <!-- University Name -->
                <TextView
                    android:id="@+id/tvUniversityName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maharshi Dayanand University"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="14sp"
                    app:autoSizeMaxTextSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:layout_marginBottom="12dp" />

                <!-- Badge 1 -->
                <LinearLayout
                    android:id="@+id/cardBadge1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_badge"
                    android:padding="8dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_school"
                        android:contentDescription="University icon"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="A State University established under Haryana Act No. XXV of 1975"
                        android:textColor="#DCE8FF"
                        android:textSize="10sp"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <!-- Badge 2 -->
                <LinearLayout
                    android:id="@+id/cardBadge2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_badge"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_verified"
                        android:contentDescription="Verified icon"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="A+ Grade University Accredited by NAAC"
                        android:textColor="#DCE8FF"
                        android:textSize="10sp"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ── About the Department Card ── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="About the\nDepartment"
                    android:textColor="@color/text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:lineSpacingMultiplier="1.15"
                    android:layout_marginBottom="8dp" />

                <!-- Accent divider -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:background="@drawable/divider_gradient"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Department of Computer Science &amp; Applications was established in 1990 under the Faculty of Physical Science with only one course i.e. Post Graduate Diploma in Computer Applications. From that day, Department has shown a commendable progress and now offering MCA, MSC (Computer Science) &amp; Ph.D(Computer Science) courses to the students. Department is one of the pioneer Department of the University and has touched almost every aspect of academics &amp; extracurricular activities. Department has proven its potential in research domain also with premium publications in SCI, SCOPUS, Web of Sciences indexed &amp; many other reputed journals. Department also has handsome number of books edited &amp; written by worthy faculty members referred country wide in almost every University. There are 10 regular Teaching Faculty members including two Professors &amp; eight Assistant Professors."
                    android:textColor="@color/text_light"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.7"
                    android:layout_marginBottom="16dp" />


            </LinearLayout>
        </androidx.cardview.widget.CardView>


        <!-- Bottom padding -->
        <View android:layout_width="match_parent" android:layout_height="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
